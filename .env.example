# Copy to .env (never commit it). Placeholders only.
# The backend reads these from the environment; set them in the shell that runs mvn.
DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
DB_USER=APP_USER
DB_PASSWORD=<APP_USER password>

# Used only once, with the hashgen profile, to create the demo password hashes.
DEMO_STUDENT_PW=<min 10 characters>
DEMO_LECTURER_PW=<min 10 characters>
DEMO_REGISTRAR_PW=<min 10 characters>
DEMO_REGISTRAR2_PW=<min 10 characters>
DEMO_AUDITOR_PW=<min 10 characters>
