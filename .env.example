# Copy to .env (never commit .env). Placeholders only - no real secrets here.

# Oracle connection (service name FREEPDB1 on Oracle Free; XEPDB1 on XE 21c; verify the actual name)
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
APP_USER=APP_USER
APP_USER_PASSWORD=change_me_locally

# Spring Boot / frontend
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# Optional: TCPS wallet location (keep wallet files outside Git)
# ORACLE_WALLET_DIR=/path/to/wallet
